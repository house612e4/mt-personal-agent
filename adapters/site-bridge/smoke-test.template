import test from 'node:test';
import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import {makeHandler} from '../netlify/agent/handler.mjs';
import {createDomain} from '../netlify/agent/domain.mjs';
import {actionInfo} from '../netlify/agent/profiles.mjs';
test('bridge refuses unsigned requests without contacting database',async()=>{let contacted=false;const h=makeHandler({site:'golapi-shop',env:{AGENT_BRIDGE_KEY:'s'.repeat(40)},getDb:()=>{contacted=true}});assert.equal((await h({httpMethod:'POST',headers:{},body:'{}'})).statusCode,401);assert.equal(contacted,false);});
test('profile has explicit site actions and no arbitrary collection writes',()=>{assert.equal(actionInfo('golapi-shop','orders.cancel').write,true);assert.equal(actionInfo('mt-studio','products.update'),null);assert.equal(actionInfo('golapi-shop','users.delete'),null);});
test('site writes are disabled until explicitly configured',async()=>{const d=createDomain({site:'golapi-shop',db:{},env:{}});await assert.rejects(()=>d.execute({action:'orders.cancel',patch:{}}),/writes বন্ধ/);});
test('MT wrapper imports the existing source validators when applicable',async t=>{const wrapper=await readFile(new URL('../netlify/functions/agent-bridge.mjs',import.meta.url),'utf8');if(wrapper.includes("site:'mt-studio'")){assert.match(wrapper,/studio-settings\.ts/);assert.match(wrapper,/site-content\.ts/);}else t.skip('MT Studio only');});
test('MT bridge uses actual brand validator and preserves unrelated brand settings',async t=>{const wrapper=await readFile(new URL('../netlify/functions/agent-bridge.mjs',import.meta.url),'utf8');if(!wrapper.includes("site:'mt-studio'"))return t.skip('MT Studio only');const{validateBrand,defaultBrand}=await import('../lib/studio-settings.ts'),{revision}=await import('../netlify/agent/common.mjs');let saved={...defaultBrand,welcome:'Keep this welcome'};const snap=()=>({exists:true,data:()=>saved,id:'brand'}),target={id:'brand',get:async()=>snap()};const db={collection:n=>({doc:()=>n==='settings'?target:{}}),runTransaction:async fn=>fn({get:async r=>r===target?snap():{exists:false},set:(r,d)=>{if(r===target)saved={...saved,...d}},create:()=>{}})};const d=createDomain({site:'mt-studio',db,validators:{validateBrand},env:{AGENT_BRIDGE_ALLOW_WRITES:'true'}});await d.execute({action:'brand.update',operationId:'a'.repeat(40),patch:{expectedRevision:revision(saved),data:{name:'New brand'}}});assert.equal(saved.name,'New brand');assert.equal(saved.welcome,'Keep this welcome');await assert.rejects(()=>d.execute({action:'brand.update',operationId:'b'.repeat(40),patch:{expectedRevision:revision(saved),data:{supportEmail:'invalid-email'}}}));});
test('MT bridge applies existing policy length validation before any write',async t=>{const wrapper=await readFile(new URL('../netlify/functions/agent-bridge.mjs',import.meta.url),'utf8');if(!wrapper.includes("site:'mt-studio'"))return t.skip('MT Studio only');const{validatePolicies}=await import('../lib/site-content.ts'),{revision}=await import('../netlify/agent/common.mjs');let writes=0;const ref={id:'policies'},db={collection:()=>({doc:()=>ref}),runTransaction:async fn=>fn({get:async()=>({exists:false}),set:()=>writes++,create:()=>writes++})},d=createDomain({site:'mt-studio',db,validators:{validatePolicies},env:{AGENT_BRIDGE_ALLOW_WRITES:'true'}});await assert.rejects(()=>d.execute({action:'policies.update',operationId:'c'.repeat(40),patch:{expectedRevision:revision(null),data:{terms:'too short'}}}));assert.equal(writes,0);});
