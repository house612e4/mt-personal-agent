# Set in Netlify UI, including Functions scope. Never upload populated .env.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste complete JSON into this single secret environment variable:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Authentication > Users > your user's UID. Exactly one owner.
OWNER_UID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MT_STUDIO_PAGE_TOKEN=
GOLAPI_SHOP_PAGE_TOKEN=
MT_STUDIO_PAGE_ID=2109209739156063
GOLAPI_SHOP_PAGE_ID=1374136539122250
# Set to a Graph API version supported by your Meta app, e.g. v23.0.
META_GRAPH_VERSION=
DRY_RUN=true

# Personal agent background runtime. Generate your own random values; never paste into chat.
INTERNAL_WORKER_SECRET=
AGENT_BASE_URL=
# 32 random bytes in base64; used to encrypt Google refresh token at rest.
CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional fallback; preferred connection is the app's Gmail OAuth button.
GMAIL_REFRESH_TOKEN=
FIREBASE_STORAGE_BUCKET=
PERSONAL_FACEBOOK_USER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
MT_STUDIO_INSTAGRAM_ID=
GOLAPI_SHOP_INSTAGRAM_ID=
# Fixed-domain signed website bridge endpoints (one per website).
MT_STUDIO_BRIDGE_URL=
MT_STUDIO_BRIDGE_KEY=
GOLAPI_SHOP_BRIDGE_URL=
GOLAPI_SHOP_BRIDGE_KEY=
# Exact site repositories: owner/name. Token needs only the selected repos.
GITHUB_AGENT_TOKEN=
MT_STUDIO_GITHUB_REPO=
GOLAPI_SHOP_GITHUB_REPO=
# Exact successful GitHub check-run names, comma separated. Required before auto-merge.
MT_STUDIO_REQUIRED_CHECKS=
GOLAPI_SHOP_REQUIRED_CHECKS=
# Optional verification of actual Netlify deployment after merge.
NETLIFY_AGENT_TOKEN=
MT_STUDIO_NETLIFY_SITE_ID=
GOLAPI_SHOP_NETLIFY_SITE_ID=
